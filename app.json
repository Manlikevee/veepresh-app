{
  "expo": {
    "name": "Veepresh",
    "slug": "veepresh",
    "version": "1.0.0",
    "scheme": "veepresh",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.veepresh.app" },
    "android": { "package": "com.veepresh.app" },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#1D6BF3" }]
    ]
  }
}
